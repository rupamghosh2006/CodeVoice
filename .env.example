# CodeVoice Environment Variables
# Copy this file to .env and fill in your values

# === REQUIRED ===
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# LLM for intent routing + code generation (Gemini 2.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL ===
# AssemblyAI streaming endpoint (default shown)
ASSEMBLYAI_WS_URL=wss://streaming.assemblyai.com/v3/ws

# AssemblyAI beta dictation endpoint (Phase 0 probe only)
ASSEMBLYAI_BETA_URL=https://dictation.assemblyai.com/transcribe

# Streaming mode: min_latency | balanced | max_accuracy (default: balanced)
ASSEMBLYAI_MODE=balanced

# Speech model (default: universal-3-5-pro)
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# UI server port (default: 3000)
PORT=3000

# Path to the file CodeVoice writes generated code into
TARGET_FILE=./demo/sample.ts

# Git working directory (default: current dir)
GIT_CWD=.
